<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the apibay relay running.

  A LaunchAgent rather than a LaunchDaemon: this runs as you, at login, with no
  root anywhere near it. It needs nothing a daemon would give it.

  KeepAlive with SuccessfulExit false means launchd restarts it whenever it dies
  for any reason other than a clean exit, which covers the case that matters:
  the process falling over at three in the morning while nobody is watching.
  ThrottleInterval stops a relay that cannot bind its port from being respawned
  in a tight loop for ever.

  There is no secret in here. The relay trusts OIDC tokens from one Vercel
  project, verified against Vercel's published keys, so the only configuration it
  needs is public: whose account and which project. A shared token would work too
  and would be one more thing for somebody to copy between two dashboards and get
  wrong.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.balerion.relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BINARY__</string>
    <string>relay</string>
    <string>--port</string>
    <string>__PORT__</string>
    <string>--vercel-project</string>
    <string>__VERCEL_PROJECT__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/relay.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/relay.err.log</string>
</dict>
</plist>
